<?xml version="1.0"?>
<package format="3">
  <name>rgbd_udp_receiver</name>
  <version>0.1.0</version>
  <description>Bounded UDP receiver, H.265/Zdepth decoder and colored point-cloud publisher.</description>
  <maintainer email="zjh@pc.local">zjh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>python3-dev</build_depend>
  <build_depend>pybind11-dev</build_depend>
  <build_depend>python3-numpy</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
